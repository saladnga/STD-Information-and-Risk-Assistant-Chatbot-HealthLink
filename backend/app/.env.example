# OpenAI API key - used for chat completions and embeddings
OPENAI_API_KEY=

# Supabase project URL (Settings -> API)
VITE_SUPABASE_URL=

# Supabase service_role key - server-side only, bypasses row-level security. Never expose to the frontend.
SUPABASE_SERVICE_KEY=

# Supabase anon key - used as a fallback client when a service-role insert fails
VITE_SUPABASE_ANON_KEY=

# Comma-separated list of allowed frontend origins for CORS, e.g. https://your-app.vercel.app
ALLOWED_ORIGINS=

# The deployed frontend's own URL - used to build the link in password-reset
FRONTEND_URL=

# Optional: allow calling /train without auth (local development only - leave unset/false in production)
ALLOW_UNAUTHENTICATED_TRAIN=false
